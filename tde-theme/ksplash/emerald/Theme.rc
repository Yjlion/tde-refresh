[KSplash Theme: emerald]
Name = Emerald
Description = Emerald KSplash Theme using the Default engine, based on the Debian 12 (bookworm) Emerald artwork by Juliette Taka
Version = 1.0
Author = tde-refresh, layout based on the Debian MoreBlue theme by Fathi Boudra
