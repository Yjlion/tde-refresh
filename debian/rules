#!/usr/bin/make -f

include /usr/share/dpkg/pkg-info.mk

# tde-refresh-desktop-base-trinity follows the default artwork of the Debian
# release it is built on, taken from desktop-base (build-dependency). Newest
# first: desktop-base keeps the themes of older releases.
DESKTOP_BASE := /usr/share/desktop-base
THEME ?= $(firstword $(foreach t,ceratopsian emerald,$(if $(wildcard $(DESKTOP_BASE)/$(t)-theme),$(t))))
THEMEDIR := $(DESKTOP_BASE)/$(THEME)-theme
PKG      := debian/tde-refresh-desktop-base-trinity
THB      := debian/theme-build

# Per theme: login background, kdesktop fallback gradient, and a version
# suffix so that builds for an older release sort below the current one and
# get their own file names.
ifeq ($(THEME),ceratopsian)
LOGIN_BG       := background.svg
COLOR1         := 39,96,130
COLOR2         := 36,64,80
VERSION_SUFFIX :=
else ifeq ($(THEME),emerald)
# The logo in background.svg would sit behind the login box.
LOGIN_BG       := background-nologo.svg
COLOR1         := 5,79,96
COLOR2         := 5,71,92
VERSION_SUFFIX := ~bpo12+1
endif

# Windows 9x themes (Chicago95 artwork is vendored under win9x/chicago95).
W9X    := debian/tde-refresh-win9x-trinity
W9XB   := debian/win9x-build
TDEDIR := opt/trinity

# Mac OS Classic and Mac OS X looks: data in macos/, one helper template.
MACB    := debian/mac-build
THEMES  := $(TDEDIR)/share/apps/kthememanager/themes

# $(call mac_helper,command,title,data dir,theme name)
define mac_helper
	sed -e 's|@COMMAND@|$(1)|g' -e 's|@TITLE@|$(2)|g' -e 's|@DATADIR@|$(3)|g' -e 's|@THEME@|$(4)|g' \
		macos/bin/tde-mac-theme.in > $(MACB)/$(1)
endef

%:
	dh $@

# Render the TDE wallpaper and TDM login background from desktop-base's SVGs,
# so TDE matches the rest of the Debian desktop.
override_dh_auto_build:
	@[ -n "$(LOGIN_BG)" ] && [ -d tde-theme/tdm/$(THEME) ] || \
		{ echo "No supported desktop-base theme found (THEME='$(THEME)')" >&2; exit 1; }
	mkdir -p $(THB)
	rsvg-convert -w 1920 -h 1200 $(THEMEDIR)/wallpaper/contents/images/1920x1200.svg -o $(THB)/wallpaper.png
	rsvg-convert -w 1920 -h 1200 $(THEMEDIR)/login/$(LOGIN_BG) -o $(THB)/background.png
	for f in tde-theme/profile/share/config/kdesktoprc tde-theme/profile/share/config/ksplashrc tde-theme/tdm/backgroundrc; do \
		sed -e 's|@THEME@|$(THEME)|g' -e 's|@COLOR1@|$(COLOR1)|' -e 's|@COLOR2@|$(COLOR2)|' \
			$$f.in > $(THB)/$${f##*/}; \
	done
	# Win9x KSplash/TDM artwork is drawn as SVG, rendered here.
	mkdir -p $(W9XB)
	rsvg-convert win9x/ksplash/top.svg -o $(W9XB)/splash_top.png
	rsvg-convert win9x/ksplash/bar-active.svg -o $(W9XB)/splash_active_bar.png
	rsvg-convert win9x/ksplash/bar-inactive.svg -o $(W9XB)/splash_inactive_bar.png
	rsvg-convert win9x/ksplash/bottom.svg -o $(W9XB)/splash_bottom.png
	cp win9x/ksplash/preview.svg $(W9XB)/
	rsvg-convert $(W9XB)/preview.svg -o $(W9XB)/Preview.png
	rsvg-convert win9x/tdm/boundingbox.svg -o $(W9XB)/boundingbox.png
	rsvg-convert win9x/tdm/background.svg -o $(W9XB)/background.png
	# Mac looks: refuse to build if the Theme Manager XML and the helper disagree.
	sh macos/check-settings.sh macos/classic/theme/MacClassic.xml macos/classic/settings.conf
	sh macos/check-settings.sh macos/osx/theme/MacOSX.xml macos/osx/settings.conf
	mkdir -p $(MACB)
	$(call mac_helper,tde-macclassic,Mac OS Classic,tde-refresh-macclassic,MacClassic)
	$(call mac_helper,tde-macosx,Mac OS X,tde-refresh-macosx,MacOSX)
	rsvg-convert macos/classic/desktop.svg -o $(MACB)/macclassic-desktop.png
	rsvg-convert macos/osx/desktop.svg -o $(MACB)/macosx-desktop.png

override_dh_auto_install:
	# tde-refresh-desktop-base-trinity
	d=$(PKG)/$(TDEDIR)/share/apps; \
	install -d $$d/tdm/themes/$(THEME) $$d/ksplash/Themes/$(THEME) $(PKG)/etc/trinity/tdm; \
	install -m 0644 tde-theme/tdm/$(THEME)/* $(THB)/background.png $$d/tdm/themes/$(THEME)/; \
	install -m 0644 tde-theme/ksplash/$(THEME)/* $$d/ksplash/Themes/$(THEME)/
	install -D -m 0644 $(THB)/wallpaper.png $(PKG)/usr/share/wallpapers/$(THEME).png
	install -m 0644 $(THB)/backgroundrc $(PKG)/etc/trinity/tdm/
	install -m 0644 $(THB)/kdesktoprc $(THB)/ksplashrc tde-theme/profile/share/config/twinrc $(PKG)/etc/trinity/
	install -D -m 0644 tde-theme/kompmgr/xcompmgrrc $(PKG)/etc/skel/.xcompmgrrc
	install -D -m 0644 tde-theme/kompmgr/compton-tde.conf $(PKG)/etc/skel/.compton-tde.conf

	# tde-refresh-win9x-trinity
	d=$(W9X)/$(TDEDIR)/share/apps; \
	install -d $$d/kthememanager/themes/Chicago95 $$d/kthememanager/themes/Win9x \
		$$d/ksplash/Themes/chicago95 $$d/tdm/themes/chicago95; \
	install -m 0644 win9x/themes/Chicago95/Chicago95.xml $$d/kthememanager/themes/Chicago95/; \
	install -m 0644 win9x/themes/Win9x/Win9x.xml $$d/kthememanager/themes/Win9x/; \
	install -m 0644 win9x/ksplash/Theme.rc $(W9XB)/splash_*.png $(W9XB)/Preview.png $$d/ksplash/Themes/chicago95/; \
	install -m 0644 win9x/tdm/chicago95/* $(W9XB)/boundingbox.png $(W9XB)/background.png $$d/tdm/themes/chicago95/
	[ ! -f win9x/themes/Chicago95/Chicago95.preview.png ] || \
		install -m 0644 win9x/themes/Chicago95/Chicago95.preview.png $(W9X)/$(TDEDIR)/share/apps/kthememanager/themes/Chicago95/
	[ ! -f win9x/themes/Win9x/Win9x.preview.png ] || \
		install -m 0644 win9x/themes/Win9x/Win9x.preview.png $(W9X)/$(TDEDIR)/share/apps/kthememanager/themes/Win9x/
	install -D -m 0755 win9x/bin/tde-win9x-panel $(W9X)/usr/bin/tde-win9x-panel
	install -D -m 0755 win9x/bin/tde-win9x-tdm $(W9X)/usr/bin/tde-win9x-tdm
	install -d $(W9X)/usr/share/icons $(W9X)/usr/share/themes $(W9X)/usr/share/wallpapers $(W9X)/usr/share/sounds $(W9X)/usr/share/plymouth/themes
	cp -a win9x/chicago95/icons/Chicago95-tux win9x/chicago95/cursors/Chicago95_* $(W9X)/usr/share/icons/
	# TDE icon lookups need a fallback for icons Chicago95 does not draw.
	sed -i 's/^Name=Chicago95 Tux$$/&\nInherits=crystalsvg,hicolor/' $(W9X)/usr/share/icons/Chicago95-tux/index.theme
	# TDE's Start button asks for "kmenu"; point it at the Tux start icon.
	for s in 16 22; do ln -sf start-here.png $(W9X)/usr/share/icons/Chicago95-tux/places/$$s/kmenu.png; done
	cp -a win9x/chicago95/gtk/Chicago95 $(W9X)/usr/share/themes/
	install -d $(W9X)/usr/share/wallpapers/Chicago95
	cp -a win9x/chicago95/backgrounds/Wallpaper win9x/chicago95/backgrounds/Patterns $(W9X)/usr/share/wallpapers/Chicago95/
	cp -a win9x/chicago95/plymouth/RetroTux $(W9X)/usr/share/plymouth/themes/
	install -d $(W9X)/usr/share/sounds/Chicago95
	install -m 0644 win9x/chicago95/sounds/* $(W9X)/usr/share/sounds/Chicago95/
	install -D -m 0644 win9x/chicago95/colors/Chicago95_TDE.kcsrc \
		$(W9X)/$(TDEDIR)/share/apps/tdedisplay/color-schemes/Chicago95_TDE.kcsrc

	# tde-refresh-macclassic-trinity
	d=debian/tde-refresh-macclassic-trinity; \
	install -D -m 0755 $(MACB)/tde-macclassic $$d/usr/bin/tde-macclassic; \
	install -d $$d/$(THEMES)/MacClassic $$d/$(TDEDIR)/share/apps/tde-refresh-macclassic; \
	install -m 0644 macos/classic/theme/* $(MACB)/macclassic-desktop.png $$d/$(THEMES)/MacClassic/; \
	install -m 0644 macos/classic/settings.conf macos/classic/kickerrc macos/classic/kicker_menubarpanelrc macos/classic/filemanagement \
		$$d/$(TDEDIR)/share/apps/tde-refresh-macclassic/

	# tde-refresh-macosx-trinity
	d=debian/tde-refresh-macosx-trinity; \
	install -D -m 0755 $(MACB)/tde-macosx $$d/usr/bin/tde-macosx; \
	install -d $$d/$(THEMES)/MacOSX $$d/$(TDEDIR)/share/apps/tde-refresh-macosx; \
	install -m 0644 macos/osx/theme/* $(MACB)/macosx-desktop.png $$d/$(THEMES)/MacOSX/; \
	install -m 0644 macos/osx/settings.conf macos/osx/kickerrc macos/osx/kicker_menubarpanelrc macos/osx/filemanagement \
		macos/osx/konqueror-toolbar.sed macos/osx/baghirarc \
		$$d/$(TDEDIR)/share/apps/tde-refresh-macosx/

# The maintainer scripts point tdmrc at the theme built here.
override_dh_installdeb:
	dh_installdeb -DTHEME=$(THEME)

override_dh_gencontrol:
	dh_gencontrol -- -v$(DEB_VERSION)$(VERSION_SUFFIX)

override_dh_auto_clean:
	rm -rf $(THB) $(W9XB) $(MACB)
