#!/usr/bin/make -f

# Ceratopsian artwork shipped by Debian's desktop-base (build-dependency).
CERATOPSIAN := /usr/share/desktop-base/ceratopsian-theme
PKG         := debian/tde-refresh-desktop-base-trinity

# Windows 9x themes (Chicago95 artwork is vendored under win9x/chicago95).
W9X    := debian/tde-refresh-win9x-trinity
W9XB   := debian/win9x-build
TDEDIR := opt/trinity

%:
	dh $@

# Render the TDE wallpaper and TDM login background from desktop-base's SVGs,
# so TDE matches the rest of the Debian trixie desktop.
override_dh_auto_build:
	rsvg-convert -w 1920 -h 1200 $(CERATOPSIAN)/wallpaper/contents/images/1920x1200.svg -o wallpaper.png
	rsvg-convert -w 1920 -h 1200 $(CERATOPSIAN)/login/background.svg -o tdm-background.png
	# Win9x KSplash/TDM artwork is drawn as SVG, rendered here.
	mkdir -p $(W9XB)
	rsvg-convert win9x/ksplash/top.svg -o $(W9XB)/splash_top.png
	rsvg-convert win9x/ksplash/bar-active.svg -o $(W9XB)/splash_active_bar.png
	rsvg-convert win9x/ksplash/bar-inactive.svg -o $(W9XB)/splash_inactive_bar.png
	rsvg-convert win9x/ksplash/bottom.svg -o $(W9XB)/splash_bottom.png
	cp win9x/ksplash/preview.svg $(W9XB)/
	rsvg-convert $(W9XB)/preview.svg -o $(W9XB)/Preview.png
	rsvg-convert win9x/tdm/boundingbox.svg -o $(W9XB)/boundingbox.png
	rsvg-convert win9x/tdm/background.svg -o $(W9XB)/background.png

override_dh_auto_install:
	install -D -m 0644 wallpaper.png $(PKG)/usr/share/wallpapers/ceratopsian.png
	install -D -m 0644 tdm-background.png $(PKG)/opt/trinity/share/apps/tdm/themes/ceratopsian/background.png
	install -D -m 0644 tde-theme/kompmgr/xcompmgrrc $(PKG)/etc/skel/.xcompmgrrc
	install -D -m 0644 tde-theme/kompmgr/compton-tde.conf $(PKG)/etc/skel/.compton-tde.conf

	# tde-refresh-win9x-trinity
	d=$(W9X)/$(TDEDIR)/share/apps; \
	install -d $$d/kthememanager/themes/Chicago95 $$d/kthememanager/themes/Win9x \
		$$d/ksplash/Themes/chicago95 $$d/tdm/themes/chicago95; \
	install -m 0644 win9x/themes/Chicago95/Chicago95.xml $$d/kthememanager/themes/Chicago95/; \
	install -m 0644 win9x/themes/Win9x/Win9x.xml $$d/kthememanager/themes/Win9x/; \
	install -m 0644 win9x/ksplash/Theme.rc $(W9XB)/splash_*.png $(W9XB)/Preview.png $$d/ksplash/Themes/chicago95/; \
	install -m 0644 win9x/tdm/chicago95/* $(W9XB)/boundingbox.png $(W9XB)/background.png $$d/tdm/themes/chicago95/
	[ ! -f win9x/themes/Chicago95/Chicago95.preview.png ] || \
		install -m 0644 win9x/themes/Chicago95/Chicago95.preview.png $(W9X)/$(TDEDIR)/share/apps/kthememanager/themes/Chicago95/
	[ ! -f win9x/themes/Win9x/Win9x.preview.png ] || \
		install -m 0644 win9x/themes/Win9x/Win9x.preview.png $(W9X)/$(TDEDIR)/share/apps/kthememanager/themes/Win9x/
	install -D -m 0755 win9x/bin/tde-win9x-panel $(W9X)/usr/bin/tde-win9x-panel
	install -d $(W9X)/usr/share/icons $(W9X)/usr/share/themes $(W9X)/usr/share/wallpapers $(W9X)/usr/share/sounds $(W9X)/usr/share/plymouth/themes
	cp -a win9x/chicago95/icons/Chicago95-tux win9x/chicago95/cursors/Chicago95_* $(W9X)/usr/share/icons/
	# TDE icon lookups need a fallback for icons Chicago95 does not draw.
	sed -i 's/^Name=Chicago95 Tux$$/&\nInherits=crystalsvg,hicolor/' $(W9X)/usr/share/icons/Chicago95-tux/index.theme
	# TDE's Start button asks for "kmenu"; point it at the Tux start icon.
	for s in 16 22; do ln -sf start-here.png $(W9X)/usr/share/icons/Chicago95-tux/places/$$s/kmenu.png; done
	cp -a win9x/chicago95/gtk/Chicago95 $(W9X)/usr/share/themes/
	install -d $(W9X)/usr/share/wallpapers/Chicago95
	cp -a win9x/chicago95/backgrounds/Wallpaper win9x/chicago95/backgrounds/Patterns $(W9X)/usr/share/wallpapers/Chicago95/
	cp -a win9x/chicago95/plymouth/RetroTux $(W9X)/usr/share/plymouth/themes/
	install -d $(W9X)/usr/share/sounds/Chicago95
	install -m 0644 win9x/chicago95/sounds/* $(W9X)/usr/share/sounds/Chicago95/
	install -D -m 0644 win9x/chicago95/colors/Chicago95_TDE.kcsrc \
		$(W9X)/$(TDEDIR)/share/apps/kdisplay/color-schemes/Chicago95_TDE.kcsrc

override_dh_auto_clean:
	rm -f wallpaper.png tdm-background.png
	rm -rf $(W9XB)
